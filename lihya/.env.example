# Copy to .env.local and fill in. Never commit .env.local.
# Firebase web config (Project settings > General > Your apps > Web)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
# App Check (App Check > Apps > reCAPTCHA v3 site key)
VITE_RECAPTCHA_SITE_KEY=
# Cloudflare Worker URL for AI Final Look, for example https://lihya-render.<you>.workers.dev
VITE_AI_WORKER_URL=
# true = use the local Firebase Emulator Suite (no real keys needed)
VITE_USE_EMULATORS=
