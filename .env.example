# Copy this file to `.env.local` and paste YOUR Firebase web config values.
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config
# If these are empty the app runs in DEMO MODE (works fully, but nothing is saved).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# One deployment = one salon. Any short id (letters, numbers, dash).
VITE_SALON_ID=main

# OPTIONAL — later upgrade: a trained nail segmentation model (.tflite) placed in public/models/
# Leave empty to use the built-in landmark + smart-fit nail detection.
VITE_NAIL_SEGMENTER_URL=
