rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public visitors can submit a request/quote — but only the signed-in
    // admin account (see SETUP.md) can read, edit, or delete leads.
    match /requests/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Formal quotations are created and managed only from the admin Quote Builder.
    match /quotations/{id} {
      allow read, write: if request.auth != null;
    }

    // Portfolio items are public to view (the public Portfolio page reads
    // them) but only the admin can add/remove items.
    match /portfolio/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone visiting the site logs a visit; only the admin can read the log.
    match /visitors/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Newsletter signups: public can add their email, only admin can read the list.
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Site config (e.g. service pricing): public can READ so the live site shows
    // current prices, but only the signed-in admin can change them.
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
