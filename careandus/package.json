{
  "name": "careandus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KHUSLA - women's hair cut, color and style simulator with on-device AI and the Agreement Card",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages --outDir dist-pages",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-careandus \"vitest run tests/rules\"",
    "emulators": "firebase emulators:start --project demo-careandus",
    "check:size": "node scripts/check-size.js",
    "i18n": "node scripts/build-i18n.mjs",
    "test:e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
